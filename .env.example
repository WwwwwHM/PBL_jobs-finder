# Application
APP_ENV=development
APP_TIMEZONE=Asia/Hong_Kong
DAILY_QUOTA=10

# Policy upgrades are opt-in during M1. Keep legacy behavior until validation passes.
RESUME_POLICY_VERSION=legacy-v1
INTERVIEW_POLICY_VERSION=interview-standard-v1
ENABLE_RESUME_DIMENSIONS=False
ENABLE_RESUME_TEMPLATES=False
ENABLE_INTERVIEW_MODES=False

# Logs are written to data/logs/app.log and rotated daily by default.
LOG_LEVEL=INFO
LOG_DIR=
LOG_BACKUP_COUNT=14

# Leave DATABASE_URL empty to use data/job_assistant.db.
DATA_DIR=
UPLOADS_DIR=
CHROMA_DIR=
DATABASE_URL=
EXPORTS_DIR=

# Gradio listens locally by default. Set 0.0.0.0 only behind a trusted firewall.
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_ANALYTICS_ENABLED=False

# AI providers
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash
ZHIPU_TIMEOUT_SECONDS=30
ZHIPU_MAX_RETRIES=2
ALIYUN_API_KEY=
ALIYUN_EMBEDDING_MODEL=qwen3.7-text-embedding
ALIYUN_EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
