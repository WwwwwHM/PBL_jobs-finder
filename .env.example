# Application
APP_ENV=development
APP_TIMEZONE=Asia/Hong_Kong
DAILY_QUOTA=10

# Logs are written to data/logs/app.log and rotated daily by default.
LOG_LEVEL=INFO
LOG_DIR=
LOG_BACKUP_COUNT=14

# Leave DATABASE_URL empty to use data/job_assistant.db.
DATABASE_URL=
EXPORTS_DIR=

# AI providers
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash
ZHIPU_TIMEOUT_SECONDS=30
ZHIPU_MAX_RETRIES=2
ALIYUN_API_KEY=
ALIYUN_EMBEDDING_MODEL=qwen3.7-text-embedding
